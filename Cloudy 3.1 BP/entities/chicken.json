					{
						"trigger": "minecraft:spawn_adult"
					},
					{
						"first_valid": [
							{
								"filters": {
									"test": "has_biome_tag",
									"value": "spawns_warm_variant_farm_animals"
								},
								"set_property": {
									"minecraft:climate_variant": "warm"
								}
							},
							{
								"filters": {
									"test": "has_biome_tag",
									"value": "spawns_cold_variant_farm_animals"
								},
								"set_property": {
									"minecraft:climate_variant": "cold"
								}
