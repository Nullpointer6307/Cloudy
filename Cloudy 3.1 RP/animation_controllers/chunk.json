{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.chunk_control": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "show": "query.property('cloudy:chunk')"
                        }
                    ]
                },
                "show": {
                    "animations": [
                        "chunk"
                    ],
                    "transitions": [
                        {
                            "default": "!query.property('cloudy:chunk')"
                        }
                    ]
                }
            }
        }
    }
}