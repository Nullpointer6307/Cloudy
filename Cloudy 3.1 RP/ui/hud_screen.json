  "hud_actionbar_text": {
    "type": "image",
    "size": [
      "100%c+9px",
      "90%c+4px"
    ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [
      0,
      25
    ],
    "texture": "textures/ui/hud_tip_text_background",
    "alpha": 0.6,
    "controls": [
      {
        "actionbar_message": {
          "type": "label",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "color": "$tool_tip_text",
          "layer": 1,
          "offset": [
            -4,
            1
          ],
          "text": "$actionbar_text",
          "text_alignment": "center",
          "localize": false,
          "alpha": 2.0
        }
      }
    ]
  },
